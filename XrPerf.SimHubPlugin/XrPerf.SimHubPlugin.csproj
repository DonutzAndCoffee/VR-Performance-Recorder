<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net48</TargetFramework>
	<UseWPF>true</UseWPF>
	<LangVersion>latest</LangVersion>
	<Nullable>disable</Nullable>
	<RootNamespace>XrPerf.SimHubPlugin</RootNamespace>
	<SimHubDir>C:\Program Files (x86)\SimHub\</SimHubDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
	<StartAction>Program</StartAction>
	<StartProgram>$(SimHubDir)SimHubWPF.exe</StartProgram>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\XrPerf.Contracts\XrPerf.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Reference Include="System.Runtime.Serialization" />
	<Reference Include="SimHub.Plugins">
	  <HintPath>$(SimHubDir)SimHub.Plugins.dll</HintPath>
	  <Private>false</Private>
	</Reference>
	<Reference Include="GameReaderCommon">
	  <HintPath>$(SimHubDir)GameReaderCommon.dll</HintPath>
	  <Private>false</Private>
	</Reference>
	<Reference Include="WoteverCommon">
	  <HintPath>$(SimHubDir)WoteverCommon.dll</HintPath>
	  <Private>false</Private>
	</Reference>
	<Reference Include="SimHub.Logging">
	  <HintPath>$(SimHubDir)SimHub.Logging.dll</HintPath>
	  <Private>false</Private>
	</Reference>
	<Reference Include="log4net">
	  <HintPath>$(SimHubDir)log4net.dll</HintPath>
	  <Private>false</Private>
	</Reference>
  </ItemGroup>

  <!-- Copying into the SimHub folder needs write access; opt in with -p:DeployToSimHub=true -->
  <Target Name="DeployToSimHub" AfterTargets="Build" Condition="'$(DeployToSimHub)' == 'true'">
	<Exec Command="XCOPY /Y /R &quot;$(TargetDir)$(TargetName).dll&quot; &quot;$(SimHubDir)&quot;" />
	<Exec Command="XCOPY /Y /R &quot;$(TargetDir)XrPerf.Contracts.dll&quot; &quot;$(SimHubDir)&quot;" />
  </Target>

</Project>
