<Window x:Class="openXRTK_Graph.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Session Comparison"
        Height="750" Width="1200"
        Background="#111111" Foreground="#DDDDDD">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A6AAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0"
                                Margin="2,2,2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: two file pickers -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnOpenA" Content="📂  Session A…" Click="BtnOpenA_Click"
                        FontSize="13" Foreground="#FF8C40"/>
                <TextBlock x:Name="TxtFileA" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="#FF8C40" Text="not loaded"/>
                <Border Width="1" Background="#333333" Margin="16,0" VerticalAlignment="Stretch"/>
                <Button x:Name="BtnOpenB" Content="📂  Session B…" Click="BtnOpenB_Click"
                        FontSize="13" Foreground="#40C8FF"/>
                <TextBlock x:Name="TxtFileB" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="#40C8FF" Text="not loaded"/>
                <Border Width="1" Background="#333333" Margin="16,0" VerticalAlignment="Stretch"/>
                <Button x:Name="BtnOpenC" Content="📂  Session C… (optional)" Click="BtnOpenC_Click"
                        FontSize="13" Foreground="#5ADC5A"/>
                <TextBlock x:Name="TxtFileC" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="#5ADC5A" Text="not loaded"/>
                <Button x:Name="BtnClearC" Content="✕" Click="BtnClearC_Click" Margin="8,0,0,0" Padding="6,2"
                        FontSize="11" ToolTip="Remove Session C" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Stats bar: one row per session -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel>
                <StackPanel x:Name="StatsBarA" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,2">
                    <Border Width="3" Background="#FF8C40" CornerRadius="1" Margin="0,2,8,2"/>
                    <TextBlock Text="A" Foreground="#FF8C40" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatsA" Foreground="#FFAA60" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="StatsBarB" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,2">
                    <Border Width="3" Background="#40C8FF" CornerRadius="1" Margin="0,2,8,2"/>
                    <TextBlock Text="B" Foreground="#40C8FF" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatsB" Foreground="#60CCFF" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="StatsBarC" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,2">
                    <Border Width="3" Background="#5ADC5A" CornerRadius="1" Margin="0,2,8,2"/>
                    <TextBlock Text="C" Foreground="#5ADC5A" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatsC" Foreground="#90F090" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Charts -->
        <TabControl Grid.Row="2" Background="#111111" Margin="4">

            <TabItem Header="Frametime Distribution">
                <oxy:PlotView x:Name="ChartCompDist" Background="#141414"/>
            </TabItem>

            <TabItem Header="FPS &amp; GPU by Frame">
                <oxy:PlotView x:Name="ChartCompOverlay" Background="#141414"/>
            </TabItem>

            <TabItem Header="Comparison Report">
                <Border Background="#161616">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="16,12">
                        <TextBlock x:Name="TxtCompReport"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="#CCCCCC" LineHeight="20"
                                   TextWrapping="NoWrap"
                                   Text="Load both sessions to see the comparison report."/>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
