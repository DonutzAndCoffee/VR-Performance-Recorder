<Window x:Class="openXRTK_Graph.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recorded sessions" Width="760" Height="480" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" Icon="Resources/app.ico"
        Background="#1A1A1A" Foreground="#DDDDDD">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Content="Refresh" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnCompare" Content="Compare selected" IsEnabled="False" Click="BtnCompare_Click"/>
            <Button x:Name="BtnDelete" Content="Delete selected" IsEnabled="False" Click="BtnDelete_Click"/>
        </StackPanel>
        <ListView x:Name="LstSessions" Grid.Row="1" Margin="0,6,0,0" SelectionMode="Extended"
                  MouseDoubleClick="LstSessions_DoubleClick" SelectionChanged="LstSessions_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Start" Width="130" DisplayMemberBinding="{Binding StartTime, StringFormat=g}"/>
                    <GridViewColumn Header="Label" Width="200" DisplayMemberBinding="{Binding Label}"/>
                    <GridViewColumn Header="App" Width="130" DisplayMemberBinding="{Binding AppName}"/>
                    <GridViewColumn Header="Duration (s)" Width="80" DisplayMemberBinding="{Binding DurationSeconds, StringFormat=F0}"/>
                    <GridViewColumn Header="Avg FPS" Width="70" DisplayMemberBinding="{Binding AverageFps, StringFormat=F1}"/>
                    <GridViewColumn Header="Files" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileCount}" ToolTip="{Binding FileNames}" Foreground="Black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" Text="Double-click opens a session. Ctrl+click 2-3 sessions and press 'Compare selected' to compare them (oldest = A). 'Delete selected' removes the sessions including all their files (CSV, frames, JSON)."
                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
