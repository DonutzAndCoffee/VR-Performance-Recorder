<Window x:Class="openXRTK_Graph.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A" Foreground="#DDDDDD">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16" Width="340">
        <GroupBox>
            <StackPanel>
                <TextBlock Text="General" Style="{StaticResource Header}"/>
                <CheckBox x:Name="ChkRecSound" Content="Play a sound when recording starts/stops"/>
                <CheckBox x:Name="ChkProcessLog" Content="Add process logging to every VR session recording" Margin="0,6,0,0"
                          ToolTip="Writes &lt;session&gt;_process.csv (CPU/RAM per process) next to the session CSV for FPS drop correlation"/>
                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                    <TextBlock Text="Process sample interval:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbProcessInterval" Width="80">
                        <ComboBoxItem Tag="100">100 ms</ComboBoxItem>
                        <ComboBoxItem Tag="200">200 ms</ComboBoxItem>
                        <ComboBoxItem Tag="500">500 ms</ComboBoxItem>
                        <ComboBoxItem Tag="1000">1000 ms</ComboBoxItem>
                        <ComboBoxItem Tag="2000">2000 ms</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox>
            <StackPanel>
                <TextBlock Text="OpenXR Perf Layer" Style="{StaticResource Header}"/>
                <TextBlock x:Name="TxtLayerState" Text="-" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnLayerInstall" Content="Install" Click="BtnLayerInstall_Click"
                            ToolTip="Register the XrPerf OpenXR layer (administrator rights required)"/>
                    <Button x:Name="BtnLayerToggle" Content="Disable" Click="BtnLayerToggle_Click"/>
                    <Button x:Name="BtnLayerUninstall" Content="Uninstall" Click="BtnLayerUninstall_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox>
            <StackPanel>
                <TextBlock Text="SimHub Plugin" Style="{StaticResource Header}"/>
                <TextBlock x:Name="TxtSimHubState" Text="-" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button x:Name="BtnSimHubPlugin" Content="Install SimHub Plugin" Click="BtnSimHubPlugin_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </GroupBox>

        <GroupBox>
            <StackPanel>
                <TextBlock Text="VR Overlay" Style="{StaticResource Header}"/>
                <CheckBox x:Name="ChkEnabled" Content="Always show overlay in headset"/>
                <CheckBox x:Name="ChkAutoWithRecording" Content="Show overlay automatically while recording"/>
                <TextBlock Text="Changes apply live (D3D11 apps only)." FontSize="11" Margin="0,0,0,8"/>

                <TextBlock Text="Display:" Margin="0,0,0,2"/>
                <CheckBox x:Name="ChkFps" Content="FPS / refresh rate"/>
                <CheckBox x:Name="ChkFrameTime" Content="Frame time"/>
                <CheckBox x:Name="ChkCpu" Content="CPU frame time (app + runtime)"/>
                <CheckBox x:Name="ChkGpu" Content="GPU frame time"/>
                <CheckBox x:Name="ChkResolution" Content="Render resolution"/>
                <CheckBox x:Name="ChkApp" Content="Application name"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Position:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbPosition" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,2">
                        <ComboBoxItem>Top left</ComboBoxItem>
                        <ComboBoxItem>Top right</ComboBoxItem>
                        <ComboBoxItem>Bottom left</ComboBoxItem>
                        <ComboBoxItem>Bottom right</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Size:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbScale" Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,2">
                        <ComboBoxItem Tag="75">Small</ComboBoxItem>
                        <ComboBoxItem Tag="100">Medium</ComboBoxItem>
                        <ComboBoxItem Tag="140">Large</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <TextBlock x:Name="TxtStatus" Text="Status: -" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <Button Content="Close" Click="BtnClose_Click" HorizontalAlignment="Right" Margin="0" Padding="16,4"/>
    </StackPanel>
</Window>
